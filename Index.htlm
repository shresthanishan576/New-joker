<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Joker: High Stakes Edition</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

<div id="root">
    <div id="vignette"></div>
    <div id="title">🃏 JOKER — THE HIGH STAKES</div>
    
    <div id="economy-bar">
        <div class="eco-item">BANK: <span id="bank-val">1000</span> 🪙</div>
        <div class="eco-item">STREAK: <span id="streak-val">0</span> 🔥</div>
    </div>

    <div id="table">
        <div class="seat" id="seat-top">
            <div class="plabel" id="lbl-1">CPU 2 <span class="cnt" id="lcnt-1"></span></div>
            <div class="hand" id="hand-1"></div>
        </div>
        <div class="seat" id="seat-left">
            <div class="plabel" id="lbl-3">CPU 3 <span class="cnt" id="lcnt-3"></span></div>
            <div class="hand" id="hand-3"></div>
        </div>
        <div id="center">
            <div id="deckPile"></div>
            <div id="status">Press Start to Deal</div>
            <button id="btnPeek" class="peek-btn">👁️ PEEK</button>
        </div>
        <div class="seat" id="seat-right">
            <div class="plabel" id="lbl-2">CPU 4 <span class="cnt" id="lcnt-2"></span></div>
            <div class="hand" id="hand-2"></div>
        </div>
        <div class="seat" id="seat-bottom">
            <div class="plabel" id="lbl-0">YOU <span class="cnt" id="lcnt-0"></span></div>
            <div class="hand" id="hand-0"></div>
        </div>
    </div>
    <div id="hint"></div>
</div>

<div id="overlay" class="show">
    <h2 id="ovTitle">🃏 Joker</h2>
    <p id="ovMsg">Be the last one holding the <strong style="color:var(--gold-bright)">Joker</strong> to win!<br>
    <small style="color:#666">Each game costs 100 🪙. Winner takes the pot.</small></p>
    <button class="ovBtn" id="btnStart">Deal Cards</button>
</div>

<script src="js/game.js"></script>
</body>
</html>
